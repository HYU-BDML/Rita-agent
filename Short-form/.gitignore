# 생성물 — Git 에 넣지 않는다.
# 컷 11개 × 후보 2개 = 영상 22개, 개당 3~5MB → 100MB 에 육박한다.
# 한 번 올리면 지워도 기록에 남아 레포가 영구히 무거워진다.
videos/*
!videos/.gitkeep
*.mp4
*.mov
*.webm

# 키컷 후보도 양이 많다. 채택본만 손으로 올린다.
keycuts/*
!keycuts/.gitkeep
# 채택본은 올린다 — 이 한 장이 11컷 전부의 기준이다.
# ※ 이 목록은 «줄 맨 앞»의 # 만 설명으로 본다. 패턴 뒤에 붙이면
#   설명까지 파일 이름의 일부로 읽어서 규칙이 통째로 죽는다.
!keycuts/K1_a.png

# 비용 기록은 로컬에만
cost.log

# 열쇠는 절대 올리지 않는다
.env
.env.*
!.env.example

# 파이썬
__pycache__/
*.pyc
.venv/
venv/

# 음원·오디오는 저작권이 있다. 레포에 넣지 않는다.
bgm/*
!bgm/.gitkeep
*.wav
*.mp3
*.m4a

# 생성된 컷 이미지도 양이 많다. 채택본만 손으로 올린다.
images/*
!images/.gitkeep

# 개발용 가짜 영상 — 원본 조각이다. 저작권도 있고 용량도 크다.
videos_fake/

# C-2 재료는 원본에서 뽑은 프레임이다. 다시 만들면 되고, 저작권도 있다.
polish/frames/
polish/pairs/

# 씬 분할 산출물 — 원본 영상·클립·프레임. 다시 만들 수 있으니 넣지 않는다.
scenes/

# 얼굴 인식 모델 39MB. 없으면 detectors.py 가 처음 쓸 때 받아 온다.
models/*.onnx

# 아카이브 DB 는 data/*.json 으로 다시 구울 수 있는 산출물
archive/*.db

# 로컬에서 쓰는 열쇠 — 배포에도 안 올라가고 Git 에도 안 들어간다.
# wrangler pages dev 가 이 파일을 읽어 env 로 넣어 준다(본 사이트의 비밀값과 별개).
.dev.vars
.dev.vars.*
