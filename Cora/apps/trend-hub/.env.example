# Dify 인스턴스. 자체 호스팅이면 https://<host>/v1
DIFY_BASE_URL=https://api.dify.ai/v1

# 앱마다 따로 발급되는 키. 없는 것은 비워 두면 그 어댑터만 목 모드로 돈다.
DIFY_KEY_MATERIAL=
DIFY_KEY_CHARACTER=
DIFY_KEY_BENCHMARK=
DIFY_KEY_CARDNEWS=
DIFY_KEY_IMAGE=
DIFY_KEY_REELS=

# 1 이면 키가 있어도 전부 목 모드로 돈다.
TREND_HUB_MOCK=

# GitHub Actions 자동 수집 요청 인증. Render와 GitHub Actions에 같은 긴 임의 값을 넣는다.
CRON_SECRET=

# 트렌드 레이더 조회 서버. 주면 파일 대신 HTTP 로 읽는다 — 두 앱이 다른 기계에 있어도 된다.
# 레이더 쪽: python3 -c "import web.serve; web.serve.serve()"   (기본 8420)
# 비우면 RADAR_RUNS_DIR(또는 ../trend-radar/runs) 폴더를 직접 읽는다.
RADAR_BASE=

# 판정기 하나가 하루에 돌 수 있는 회차 수 (한국 날짜 기준). 비우면 3.
# 합쳐서 세면 뉴스를 몇 번 돌린 날 캐릭터를 아예 못 돌린다. 축마다 따로 센다.
TREND_HUB_MAX_RUNS_PER_DISCOVERY=

# 판정기를 가리지 않은 하루 천장. 비우면 10.
# 배포본에는 로그인이 없다. 주소를 아는 사람이면 누구나 수집을 누를 수 있으므로
# 이 숫자가 하루치 API 비용의 천장이다. 0 을 넣으면 수집이 아예 안 돈다.
TREND_HUB_MAX_RUNS_PER_DAY=

# 그중 GitHub Actions 자동 수집이 가져갈 몫. 비우면 3. 나머지는 사람이 누를 자리로 남는다.
TREND_HUB_MAX_AUTOMATIC_RUNS_PER_DAY=

# fal.ai — 주제 포스터의 키비주얼(글자 없는 배경 한 장)
# 한글 카피는 브라우저가 얹으므로 여기서 그리는 건 그림뿐입니다.
# 어디서: Dify 이미지 생성 워크플로우 → 환경 변수 → FAL_KEY
FAL_KEY=

# 카드뉴스 렌더 서버 — 원고를 보내면 틀 8종 × 겉모습 37벌로 구워 줍니다.
# 우리가 문구를 쓰고 서버가 그림을 만듭니다. 없으면 브라우저 시안까지만 됩니다.
RENDER_BASE=https://cardnews-render.onrender.com

# Gemini — 이미지 생성과 영상 분석에 같은 키를 씁니다.
# 이미지: 참조 이미지를 함께 넣어 외형을 지어내지 않게 합니다.
# 영상  : YouTube URL 을 그대로 넣습니다. 공개 영상만 되고 무료 등급은 하루 8시간입니다.
# 어디서: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 모델을 바꿔 볼 때만 씁니다. 비우면 아래 기본값을 씁니다.
GEMINI_IMAGE_MODEL=
GEMINI_VIDEO_MODEL=

# ──────────────────────────────────────────────────────────────
# 앱이 직접 부르는 API (Dify 를 거치지 않는 경로). 2026-09-18 추가.
# Render 대시보드에 넣을 목록이 곧 이 아래다 — render.yaml 의 sync:false 와 짝이다.
# ──────────────────────────────────────────────────────────────

# Anthropic — 이름 추출 · 권리 판정 · 본문 요약. 셋 다 이 키 하나를 쓴다.
# 없으면 캐릭터 발굴이 통째로 목 모드가 된다. 회차당 약 $0.8.
# 어디서: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# TikHub — 인스타·X·틱톡 수집. 호출당 과금이고 회차당 15콜(검색어 5 × 플랫폼 3)이다.
# 어디서: https://user.tikhub.io
TIKHUB_KEY=

# YouTube Data API — 후보에 유튜브 영상을 붙인다(무료 할당량 안에서).
YOUTUBE_KEY=

# 네이버 검색 추이 — 캐릭터·주제의 시간축. 무료다.
# 어디서: https://developers.naver.com/apps
NAVER_ID=
NAVER_SECRET=

# 특허청 KIPRIS — 상표 조회로 권리 귀속을 보강한다. 지금은 안 쓰는 경로다.
KIPRIS_SERVICE_KEY=

# 트렌드 레이더 회차 폴더. **배포에서는 비워 둔다.**
# 레이더는 수집기가 아니라 로컬 파이썬 앱이 남긴 폴더를 읽는 판정기라,
# 그 폴더가 없는 환경에서는 화면에서 알아서 내려간다(쌓인 회차는 그대로 보인다).
# 비우면 ../trend-radar/runs 를 본다.
RADAR_RUNS_DIR=
